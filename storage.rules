rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid));
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }

    function isSupportAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Uploaded before ticket submission; no download URL or public access.
    match /supportAttachments/{uid}/{ticketId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isSupportAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid &&
        ticketId.matches('[A-Za-z0-9_-]{8,120}') && fileName.matches('[A-Za-z0-9_.-]+') &&
        request.resource != null && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if signedIn() && (request.auth.uid == uid || isSupportAdmin());
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    match /chatMedia/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
        && resource == null
        && firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('closedAt', null) == null
        && fileName.matches(request.auth.uid + '-.*')
        && request.resource.metadata.get('ownerUid', '') == request.auth.uid
        && request.resource.metadata.get('chatId', '') == chatId
        && validImageUpload();
      allow update: if false;
      allow delete: if isChatParticipant(chatId)
        && resource.metadata.get('ownerUid', '') == request.auth.uid
        && fileName.matches(request.auth.uid + '-.*');
    }

    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

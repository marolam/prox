{
  "name": "functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc --noEmitOnError",
    "test:rules": "node --test test/firestore.rules.test.cjs",
    "test:backend": "npm run build && node --test test/backend.test.cjs",
    "test:emulators": "npm run build && firebase emulators:exec --config ../firebase.json --project demo-prox-audit --only firestore,storage \"node --test --test-concurrency=1 test/firestore.rules.test.cjs test/backend.test.cjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}

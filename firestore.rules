rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/accountEnforcements/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/accountEnforcements/$(request.auth.uid)).data.get('status', 'suspended') == 'active') &&
        !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    match /accountEnforcements/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /accountModerationAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /functionRateLimits/{uid} {
      allow read, write: if false;
    }

    function isAdmin() {
      return authed() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(uid) {
      return authed() && request.auth.uid == uid;
    }

    function isMutualPartyMember(uid) {
      return authed() && request.auth.uid != uid &&
        !exists(/databases/$(database)/documents/accountDeletions/$(uid)) &&
        !exists(/databases/$(database)/documents/users/$(uid)/blocks/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)/party/$(request.auth.uid)).data.get('mutual', false) == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/party/$(uid)).data.get('mutual', false) == true &&
        get(/databases/$(database)/documents/users/$(uid)/party/$(request.auth.uid)).data.get('metInPerson', false) == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/party/$(uid)).data.get('metInPerson', false) == true;
    }

    function hasParticipants(data) {
      return data.get('participants', []) is list;
    }

    function inParticipants(data) {
      return authed() && referralTrustReady(request.auth.uid) && request.auth.uid in data.get('participants', []);
    }

    function inPair(data) {
      return authed() && referralTrustReady(request.auth.uid) && (
        request.auth.uid == data.get('aUid', '') ||
        request.auth.uid == data.get('bUid', '') ||
        request.auth.uid == data.get('requesterUid', '') ||
        request.auth.uid == data.get('recipientUid', '') ||
        request.auth.uid == data.get('fromUid', '') ||
        request.auth.uid == data.get('toUid', '')
      );
    }

    function ownerUid(data) {
      return data.get('ownerUid', null) is string
        ? data.ownerUid
        : data.get('userId', null) is string
          ? data.userId
          : data.get('uid', null) is string
            ? data.uid
            : data.get('createdBy', null) is string
              ? data.createdBy
              : data.get('reporterUid', null) is string
                ? data.reporterUid
                : "";
    }

    function isDocOwner(data) {
      return authed() && ownerUid(data) != "" && request.auth.uid == ownerUid(data);
    }

    function consistentOwnerAliases(data) {
      return data.get('uid', request.auth.uid) == request.auth.uid &&
        data.get('ownerUid', request.auth.uid) == request.auth.uid &&
        data.get('userId', request.auth.uid) == request.auth.uid &&
        data.get('createdBy', request.auth.uid) == request.auth.uid &&
        data.get('reporterUid', request.auth.uid) == request.auth.uid;
    }

    function supportCanRead(data) {
      return isDocOwner(data) ||
        request.auth.uid == data.get('technicianId', '') ||
        request.auth.uid == data.get('managerId', '') ||
        isAdmin();
    }

    function meetupParticipant(data) {
      return inParticipants(data) || inPair(data);
    }

    function noBlock(a, b) {
      return a is string && b is string && a != '' && b != '' &&
        !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b)) &&
        !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function referralTrustReady(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)) ||
        get(/databases/$(database)/documents/users/$(uid)).data.get('referralTrustRequired', false) != true ||
        get(/databases/$(database)/documents/users/$(uid)).data.get('referralInPersonVerified', false) == true;
    }

    function validChat(data) {
      return referralTrustReady(request.auth.uid) && data.participants is list && data.participants.size() >= 2 &&
        data.participants.size() <= 50 &&
        data.participants.toSet().size() == data.participants.size() &&
        (data.participants.size() != 2 || noBlock(data.participants[0], data.participants[1]));
    }

    function chatResponseWindow(gate) {
      return gate.get('modeKind', '') == 'normal' && gate.get('responseWindowSeconds', 0) == 60 ? 60 : 86400;
    }

    function chatGateWriteAllowed(old, next) {
      let before = old.get('chatGate', {});
      let after = next.get('chatGate', {});
      let from = before.get('status', '');
      let to = after.get('status', '');
      let deadline = before.get('requestedAt', request.time) + duration.value(chatResponseWindow(before), 's');
      return (from != 'requested' || to != 'expired' ||
          (before.get('requestedAt', null) is timestamp && request.time >= deadline)) &&
        (from != 'requested' || !(to in ['accepted', 'declined']) ||
          (request.auth.uid != before.get('requestedBy', '') && request.time < deadline)) &&
        (!(from in ['accepted', 'declined']) || to != 'requested') &&
        (from != 'requested' || to != 'requested' ||
          (after.get('requestedAt', null) == before.get('requestedAt', null) &&
           after.get('requestedBy', '') == before.get('requestedBy', '') &&
           after.get('modeKind', '') == before.get('modeKind', '') &&
           after.get('responseWindowSeconds', 0) == before.get('responseWindowSeconds', 0))) &&
        (from != 'expired' || to != 'requested' ||
          (old.get('closedAt', null) == null && before.get('expiredBySystem', false) == true &&
           before.get('acceptedAt', null) == null && before.get('declinedAt', null) == null &&
           before.get('acceptedBy', '') == '' && before.get('declinedBy', '') == '' &&
           after.get('requestedBy', '') == request.auth.uid && after.get('requestedAt', null) == request.time &&
           validChat(next)));
    }

    function immutablePair() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'participants', 'aUid', 'bUid', 'requesterUid', 'recipientUid'
      ]);
    }

    function pairNotBlocked(data) {
      return data.get('participants', []).size() == 2
        ? noBlock(data.participants[0], data.participants[1])
        : noBlock(data.get('aUid', data.get('requesterUid', '')),
                  data.get('bUid', data.get('recipientUid', '')));
    }

    function validMessage(data, chat) {
      return chat.get('closedAt', null) == null && data.get('from', '') == request.auth.uid &&
        data.get('text', '') is string && data.get('text', '').size() <= 10000 &&
        data.get('kind', 'text') in ['text', 'image', 'system'] &&
        data.get('to', '') in chat.participants &&
        data.get('to', '') != request.auth.uid &&
        noBlock(request.auth.uid, data.get('to', '')) &&
        data.get('read', false) == false;
    }

    function safeSupportCreate(data) {
      return isDocOwner(data) && consistentOwnerAliases(data) && !data.keys().hasAny([
        'technicianId', 'managerId', 'payoutGranted', 'payoutCredited',
        'doneDealConfirmed', 'rewardGranted', 'rewardCredited',
        'firstResponseAt', 'fixedVersion', 'fixedBuild', 'resolvedAt',
        'acknowledgedAt', 'acknowledgedAutomaticallyAt', 'responseDueAt',
        'workflow', 'submissionHash', 'lastReply', 'lastReplyAt'
      ]) && data.get('status', 'open') in ['open', 'new', 'submitted', 0];
    }

    function ownerReportUpdate() {
      return isDocOwner(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'subject', 'message', 'body', 'note',
          'detail', 'reason', 'route', 'updatedAt', 'createdAt'
        ]);
    }

    function validMeetupStatusEventUpdate() {
      return (
          !request.resource.data.keys().hasAny(["lastStatusEvent"]) &&
          !resource.data.keys().hasAny(["lastStatusEvent"])
        ) || (
          request.resource.data.keys().hasAny(["lastStatusEvent"]) &&
          resource.data.keys().hasAny(["lastStatusEvent"]) &&
          request.resource.data.lastStatusEvent == resource.data.lastStatusEvent
        ) ||
        (
          request.resource.data.keys().hasAny(["lastStatusEvent"]) &&
          request.resource.data.lastStatusEvent is map &&
          request.resource.data.lastStatusEvent.actorUid == request.auth.uid &&
          request.resource.data.lastStatusEvent.id is string &&
          request.resource.data.lastStatusEvent.type in [
            "location_confirmed",
            "on_my_way",
            "ready_to_verify",
            "arrived",
            "meetup_completed"
          ]
        );
    }

    function cancelEvidenceValid(value) {
      return value is timestamp ||
        (value is string && value.size() > 0) ||
        (value is map && (
          (value.get('requestId', '') is string && value.get('requestId', '').size() > 0) ||
          value.get('requestedAt', null) is timestamp ||
          value.get('confirmedAt', null) is timestamp ||
          value.get('ts', null) is timestamp ||
          value.get('at', null) is timestamp
        ));
    }

    function handshakeEvidenceByUid(next) {
      return next.get('cancelHandshakeByUid', null) is map
        ? next.get('cancelHandshakeByUid', {})
        : next.get('cancelHandshake', null) is map
          ? next.get('cancelHandshake', {})
          : {};
    }

    function mutualCancelHandshake(next) {
      let aUid = next.get('aUid', '');
      let bUid = next.get('bUid', '');
      let evidence = handshakeEvidenceByUid(next);
      return aUid is string && aUid != '' &&
        bUid is string && bUid != '' &&
        cancelEvidenceValid(evidence.get(aUid, null)) &&
        cancelEvidenceValid(evidence.get(bUid, null));
    }

    function validCancelHandshakeActorWrite(old, next) {
      let changed = next.diff(old).affectedKeys();
      let touched = changed.hasAny([
        'cancelRequestedByA', 'cancelConfirmedByA',
        'cancelRequestedByB', 'cancelConfirmedByB',
        'cancelRequestedBy', 'cancelConfirmedBy',
        'cancelHandshake', 'cancelHandshakeByUid'
      ]);
      let aUid = old.get('aUid', '');
      let bUid = old.get('bUid', '');
      let isA = request.auth.uid == aUid;
      let isB = request.auth.uid == bUid;
      let oldByUid = old.get('cancelHandshakeByUid', null) is map ? old.get('cancelHandshakeByUid', {}) : {};
      let nextByUid = next.get('cancelHandshakeByUid', null) is map ? next.get('cancelHandshakeByUid', {}) : {};
      return !touched || (
        (isA || isB) &&
        !changed.hasAny(['cancelRequestedBy', 'cancelConfirmedBy', 'cancelHandshake']) &&
        (isA
          ? (
              next.get('cancelRequestedByB', false) == old.get('cancelRequestedByB', false) &&
              next.get('cancelConfirmedByB', false) == old.get('cancelConfirmedByB', false) &&
              (!changed.hasAny(['cancelHandshakeByUid']) || (
                nextByUid.get(bUid, null) == oldByUid.get(bUid, null) &&
                cancelEvidenceValid(nextByUid.get(aUid, null))
              ))
            )
          : (
              next.get('cancelRequestedByA', false) == old.get('cancelRequestedByA', false) &&
              next.get('cancelConfirmedByA', false) == old.get('cancelConfirmedByA', false) &&
              (!changed.hasAny(['cancelHandshakeByUid']) || (
                nextByUid.get(aUid, null) == oldByUid.get(aUid, null) &&
                cancelEvidenceValid(nextByUid.get(bUid, null))
              ))
            )
        )
      );
    }

    function validMeetupProgress() {
      let old = resource.data;
      let next = request.resource.data;
      let from = old.get('status', '');
      let to = next.get('status', '');
      let fresh = to == 'requested' && from in ['completed', 'expired', 'cancelled', 'auto_closed', 'declined'];
      let cancelByHandshake = from in ['requested', 'accepted', 'live'] && to == 'cancelled' && mutualCancelHandshake(next);
      return !next.diff(old).affectedKeys().hasAny(['outcome', 'closedAt', 'cancelledAt', 'autoClosedAt']) &&
        validCancelHandshakeActorWrite(old, next) &&
        (fresh || from in ['requested', 'accepted', 'live'] || next.diff(old).affectedKeys().hasOnly(['sessionScreens', 'updatedAt', 'ratingStartedAt', 'ratingExpiresAt'])) &&
        (from == to || fresh ||
          (from == 'requested' && to in ['accepted', 'live', 'declined', 'expired']) ||
          (from == 'accepted' && to in ['live', 'completed', 'expired']) ||
          (from == 'live' && to in ['completed', 'expired']) ||
          cancelByHandshake) &&
        (fresh || old.get('locationStatus', '') != 'confirmed' ||
          (next.get('lat', null) == old.get('lat', null) && next.get('lng', null) == old.get('lng', null) && next.get('locationStatus', '') == 'confirmed')) &&
        (fresh || (old.get('aArrived', false) != true || next.get('aArrived', false) == true)) &&
        (fresh || (old.get('bArrived', false) != true || next.get('bArrived', false) == true));
    }

    function validArrivalUpdate() {
      let old = resource.data;
      let next = request.resource.data;
      let peer = request.auth.uid == old.get('aUid', '') ? 'bArrived' : 'aArrived';
      let reset = old.get('status', '') in ['completed', 'expired', 'cancelled', 'auto_closed', 'declined'] &&
        next.get('status', '') in ['requested', 'live'] &&
        next.get('aArrived', false) == false && next.get('bArrived', false) == false;
      return (next.get(peer, false) == old.get(peer, false) || reset) &&
        (old.get('status', '') != 'completed' || next.get('status', '') != 'completed' ||
          next.get('completedAt', null) == old.get('completedAt', null)) &&
        (next.get('status', '') != 'completed' ||
          (next.get('aArrived', false) == true && next.get('bArrived', false) == true));
    }

    function ratingParticipant(meetupId) {
      return authed() && meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data);
    }

    function validRating(meetupId, entryId) {
      return entryId == request.auth.uid && ratingParticipant(meetupId) &&
        get(/databases/$(database)/documents/meetups/$(meetupId)).data.status == 'completed' &&
        request.resource.data.thumb is bool &&
        request.resource.data.keys().hasOnly(['thumb', 'reason', 'ts']);
    }

    // --- USER ROOT + NESTED OWNER DATA ---
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.get('referrer', '') in ['', null] && request.resource.data.get('root_referrer', '') in ['', null] &&
        !request.resource.data.keys().hasAny(['referralInPersonVerified', 'disabled', 'banned']) &&
        request.resource.data.get('referralTrustRequired', true) == true;
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referrer', 'root_referrer', 'referralTrustRequired', 'referralInPersonVerified', 'disabled', 'banned']);
      allow delete: if false;

      match /presence/{docId} {
        allow read: if authed();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && (docId != 'current' ||
          (request.resource.data.get('geopoint', null) is latlng && request.resource.data.get('ts', null) == request.time));
      }

      // Background location is private to its owner and the trusted matcher.
      match /backgroundPresence/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'current' &&
          get(/databases/$(database)/documents/users/$(uid)/settings/backgroundMatching).data.get('enabled', false) == true &&
          request.resource.data.keys().hasOnly(['enabled', 'deviceId', 'latitude', 'longitude', 'locationAt', 'receivedAt', 'accuracyMeters', 'speedMps', 'utcOffsetMinutes', 'expiresAt']) &&
          request.resource.data.enabled == true &&
          request.resource.data.deviceId == get(/databases/$(database)/documents/users/$(uid)/settings/backgroundMatching).data.deviceId &&
          request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
          request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 &&
          request.resource.data.locationAt is timestamp &&
          request.resource.data.locationAt >= request.time - duration.value(30, 'm') &&
          request.resource.data.locationAt <= request.time + duration.value(1, 'm') &&
          request.resource.data.receivedAt == request.time &&
          request.resource.data.accuracyMeters is number && request.resource.data.accuracyMeters >= 0 && request.resource.data.accuracyMeters <= 300 &&
          request.resource.data.speedMps is number && request.resource.data.speedMps >= -1 && request.resource.data.speedMps <= 100 &&
          request.resource.data.utcOffsetMinutes is number && request.resource.data.utcOffsetMinutes >= -720 && request.resource.data.utcOffsetMinutes <= 840 &&
          request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(31, 'm');
      }
      // Budgets, delivery receipts and opportunities are server-owned. The callable
      // rechecks freshness and blocks before revealing an opportunity.
      match /backgroundAlertState/{id} { allow read, write: if false; }
      match /backgroundAlertPairs/{id} { allow read, write: if false; }
      match /backgroundScanState/{id} { allow read, write: if false; }
      match /backgroundAlertOutbox/{id} { allow read, write: if false; }
      match /backgroundOpportunities/{id} { allow read, write: if false; }
      // Public availability and trusted graph receipts can only be issued by the server.
      match /matchingAccess/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && (docId != 'matching' ||
          (request.resource.data.get('partyScope', 'tree') in ['partyOnly', 'tree', 'public', 'all', 'extendedOnly', 'none'] &&
            (!(request.resource.data.get('partyScope', 'tree') in ['public', 'all']) ||
              (resource != null && request.resource.data.get('partyScope', 'tree') == resource.data.get('partyScope', 'tree')) ||
              get(/databases/$(database)/documents/users/$(uid)/matchingAccess/current).data.get('publicUnlocked', false) == true)));
      }

      match /meta/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && !(docId in ['points', 'progression', 'inPartyMatchMetrics', 'matching']);

        match /events/{eventId} {
          allow read: if isOwner(uid);
          allow write: if isOwner(uid) && !(docId in ['points', 'inPartyMatchMetrics']);
        }
      }

      match /party/{partyUid} {
        allow read: if isOwner(uid);
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }

      match /partyProfile/{docId} {
        allow read: if isOwner(uid) || isMutualPartyMember(uid);
        allow write: if isOwner(uid);
      }

      // Location/points cache used by runtime presence and bootstrap flows.
      match /points/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /notes/{otherUid} {
        allow read, write: if isOwner(uid);
      }

      match /hiddenKeywords/{reportId} {
        allow read, write: if isOwner(uid);
      }

      match /partyPrivateNotes/{otherUid} {
        allow read, write: if isOwner(uid);
      }

      match /blocks/{blockedUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && blockedUid != uid &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == blockedUid;
        allow delete: if isOwner(uid);
      }

      match /trustFeedback/{meetupId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['meetupId', 'otherUid', 'wouldMeetAgain', 'updatedAt']) &&
          request.resource.data.meetupId == meetupId &&
          request.resource.data.wouldMeetAgain is bool &&
          request.resource.data.otherUid != uid &&
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.status == 'completed' &&
          meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data) &&
          request.resource.data.otherUid in [
            get(/databases/$(database)/documents/meetups/$(meetupId)).data.aUid,
            get(/databases/$(database)/documents/meetups/$(meetupId)).data.bUid
          ];
      }

      match /meetupOutcomes/{outcomeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /activityEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.delta == 0 &&
          request.resource.data.keys().hasOnly(['kind', 'title', 'delta', 'meta', 'createdAt']) &&
          request.resource.data.kind is string && request.resource.data.kind.size() <= 80 &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
          request.resource.data.meta is string && request.resource.data.meta.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
      }

      match /referrals/{inviteeUid} {
        allow read: if isOwner(uid) ||
          (authed() && request.auth.uid == inviteeUid) ||
          (authed() && resource.data.uid is string && request.auth.uid == resource.data.uid);
        allow create: if isOwner(uid) && !request.resource.data.keys().hasAny([
          'rewardGranted', 'rewardCredited', 'inPersonVerified', 'rewardEligible', 'meetupsCompleted', 'referralsCompleted'
        ]);
        allow update: if isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'rewardGranted', 'rewardCredited', 'inPersonVerified', 'rewardEligible', 'meetupsCompleted', 'referralsCompleted'
          ]);
        allow delete: if false;
      }

      match /mentorReferrals/{inviteeUid} {
        allow get: if isOwner(uid) &&
          !exists(/databases/$(database)/documents/accountDeletions/$(inviteeUid)) &&
          noBlock(uid, inviteeUid) &&
          get(/databases/$(database)/documents/users/$(inviteeUid)).data.get('referrer', '') == uid;
        allow write: if false;
      }

      match /referralMentor/{docId} {
        allow read: if isOwner(uid) && docId == 'current' &&
          (!exists(/databases/$(database)/documents/users/$(uid)/referralMentor/current) ||
            (noBlock(uid, resource.data.mentorUid) &&
              !exists(/databases/$(database)/documents/accountDeletions/$(resource.data.mentorUid))));
        allow write: if false;
      }

      match /stats/{docId} {
        allow read: if isOwner(uid) || (authed() && docId == 'trust');
        allow write: if false;
      }

      match /billing/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /items/{itemId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /business/{docId} {
        allow read, write: if isOwner(uid);

        match /{subPath=**} {
          allow read, write: if isOwner(uid);
        }
      }

      match /store/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /items/{itemId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // --- PROFILE MIRROR ---
    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isOwner(uid);
    }

    match /publicProfiles/{uid} {
      allow get: if authed();
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- CHATS + THREADS ---
    match /chats/{chatId} {
      allow create: if authed() && inParticipants(request.resource.data) &&
        request.resource.data.get('closedAt', null) == null &&
        validChat(request.resource.data) &&
        request.resource.data.get('moderatorUid', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid;
      // Keep this predicate direct (no helper indirection) so query analysis
      // can validate `where('participants', arrayContains: uid)` listeners.
      // Important for transaction preflight: allow reads when doc is missing,
      // otherwise tx.get(chats/{id}) can fail before create on brand-new pairs.
      allow read: if authed() && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if authed() && request.auth.uid in resource.data.participants &&
        chatGateWriteAllowed(resource.data, request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'moderatorUid', 'isGroup', 'closedAt']) &&
        (resource.data.get('closedAt', null) == null || request.resource.data.get('chatGate', {}) == resource.data.get('chatGate', {})) &&
        (request.resource.data.participants == resource.data.participants ||
          (resource.data.get('isGroup', false) == true &&
            resource.data.get('moderatorUid', '') == request.auth.uid && validChat(request.resource.data) &&
            request.auth.uid in request.resource.data.participants));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if authed() && inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if authed() &&
          inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
          validMessage(request.resource.data, get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow update: if authed() &&
          inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
          resource.data.get('to', '') == request.auth.uid &&
          request.resource.data.read == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if isAdmin();
      }

      match /typing/{uid} {
        allow read: if authed() && inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow write: if authed() && request.auth.uid == uid && inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
      }

      match /members/{uid} {
        allow read: if authed() && inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow write: if authed() && request.auth.uid == uid && inParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
      }
    }

    match /threads/{threadId} {
      allow read: if authed() && inParticipants(resource.data);
      allow create: if authed() && inParticipants(request.resource.data) && validChat(request.resource.data);
      allow update: if authed() && inParticipants(resource.data) && immutablePair();
      match /messages/{messageId} {
        allow read: if authed() && inParticipants(get(/databases/$(database)/documents/threads/$(threadId)).data);
        allow create: if authed() && inParticipants(get(/databases/$(database)/documents/threads/$(threadId)).data) &&
          validMessage(request.resource.data, get(/databases/$(database)/documents/threads/$(threadId)).data);
      }
    }

    // --- MATCHES + MEETUPS ---
    match /matches/{matchId} {
      allow create: if authed() && inParticipants(request.resource.data) &&
        validChat(request.resource.data) && request.resource.data.participants.size() == 2;
      // Keep read predicate query-simple for arrayContains listeners.
      allow read: if authed() && request.auth.uid in resource.data.participants;
      allow update: if authed() && immutablePair() && (
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        (resource.data.aUid is string && request.auth.uid == resource.data.aUid) ||
        (resource.data.bUid is string && request.auth.uid == resource.data.bUid) ||
        (resource.data.requesterUid is string && request.auth.uid == resource.data.requesterUid) ||
        (resource.data.recipientUid is string && request.auth.uid == resource.data.recipientUid)
      );
    }

    // Collection-group presence listeners need an explicit recursive match.
    // Writes still flow through /users/{uid}/presence/{docId} owner rules above.
    match /{path=**}/presence/{docId} {
      allow read: if authed();
      allow write: if false;
    }

    match /meetups/{meetupId} {
      allow create: if authed() && meetupParticipant(request.resource.data) && pairNotBlocked(request.resource.data) &&
        (!exists(/databases/$(database)/documents/chats/$(meetupId)) || get(/databases/$(database)/documents/chats/$(meetupId)).data.get('closedAt', null) == null) &&
        request.resource.data.get('status', '') != 'completed' &&
        request.resource.data.get('aArrived', false) == false && request.resource.data.get('bArrived', false) == false;
      // Transaction preflight must be able to read a missing deterministic
      // pair document before creating it. Existing meetups stay participant-only.
      allow read: if authed() &&
        (resource == null || meetupParticipant(resource.data));
      allow update: if authed() && meetupParticipant(resource.data) &&
        immutablePair() && validMeetupStatusEventUpdate() && validArrivalUpdate() && validMeetupProgress() &&
        (request.resource.data.get('status', '') != 'requested' || (pairNotBlocked(request.resource.data) &&
          (!exists(/databases/$(database)/documents/chats/$(meetupId)) || get(/databases/$(database)/documents/chats/$(meetupId)).data.get('closedAt', null) == null)));
      allow delete: if authed() && meetupParticipant(resource.data) &&
        resource.data.get('status', '') in ['completed', 'cancelled', 'declined', 'expired', 'auto_closed'];

      match /beacon/{docId} {
        allow read, write: if authed() && meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data) &&
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.status == 'live' &&
          pairNotBlocked(get(/databases/$(database)/documents/meetups/$(meetupId)).data);
      }

      match /notes/{noteId} {
        allow read: if authed() &&
          meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data);
        allow create: if authed() &&
          meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.createdAt == request.time;
        allow update: if authed() &&
          meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
        allow delete: if authed() &&
          meetupParticipant(get(/databases/$(database)/documents/meetups/$(meetupId)).data) &&
          resource.data.uid == request.auth.uid;
      }
    }

    match /meetupRequests/{requestId} {
      allow create: if authed() && meetupParticipant(request.resource.data) && pairNotBlocked(request.resource.data) &&
        !(request.resource.data.get('kind', '') in ['partyPresence', 'partyHandshake', 'partyAddRequest']);
      allow read, delete: if authed() && meetupParticipant(resource.data);
      allow update: if authed() && meetupParticipant(resource.data) && immutablePair() &&
        !(request.resource.data.get('kind', '') in ['partyPresence', 'partyHandshake', 'partyAddRequest']) &&
        !(resource.data.get('kind', '') in ['partyPresence', 'partyHandshake', 'partyAddRequest']);
    }

    // Owner-visible aggregate request/result. The backend computes results and
    // never returns second-degree user identities.
    match /partyNetworkRequests/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'requestNonce', 'requestedAt', 'status'
        ]);
      allow update: if isOwner(uid) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.requestedAt == request.time &&
        request.time > resource.data.requestedAt + duration.value(1, 'm') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerUid', 'requestNonce', 'requestedAt', 'status'
        ]);
      allow delete: if isOwner(uid);
    }

    // --- SUPPORT / REFERRALS / INCIDENTS / REPORTING ---
    match /support_tickets/{ticketId} {
      allow create: if authed() && safeSupportCreate(request.resource.data);
      allow read: if authed() && supportCanRead(resource.data);
      allow update: if isAdmin() || ownerReportUpdate();
      allow delete: if isAdmin();
    }

    match /referralCodes/{code} {
      allow read: if authed();
      allow create: if authed() && referralTrustReady(request.auth.uid) && request.resource.data.get('source', '') != 'growth' &&
        request.resource.data.get('referrerUid', ownerUid(request.resource.data)) == request.auth.uid &&
        request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      allow update: if resource.data.get('source', '') != 'growth' && (isAdmin() || (authed() && resource.data.get('referrerUid', ownerUid(resource.data)) == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referrerUid', 'rootReferrerUid', 'ownerUid', 'uid', 'userId', 'blocked', 'flagged', 'source'])));
      allow delete: if resource.data.get('source', '') != 'growth' && (isAdmin() || (authed() && resource.data.get('referrerUid', ownerUid(resource.data)) == request.auth.uid));
    }

    match /partyConnections/{connectionId} {
      allow read: if authed() && request.auth.uid in resource.data.members;
      allow write: if false;
    }
    match /partyInPersonSessions/{id} { allow read, write: if false; }
    match /partyInPersonCodes/{id} { allow read, write: if false; }
    match /matchingLocations/{uid} { allow read, write: if false; }
    match /matchingConfig/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ratings/{ratingId} {
      allow create: if authed() && (isDocOwner(request.resource.data) || meetupParticipant(request.resource.data));
      allow read: if authed() && (isDocOwner(resource.data) || meetupParticipant(resource.data) || isAdmin());
      allow update, delete: if authed() && (isDocOwner(resource.data) || isAdmin());

      match /entries/{entryId} {
        allow read: if (authed() && entryId == request.auth.uid && ratingParticipant(ratingId)) || isAdmin();
        allow create, update: if authed() && validRating(ratingId, entryId);
      }
    }

    match /ratings_meetups/{meetupId} {
      allow create: if authed() && (isDocOwner(request.resource.data) || meetupParticipant(request.resource.data));
      allow read: if authed() && (isDocOwner(resource.data) || meetupParticipant(resource.data) || isAdmin());
      allow update, delete: if authed() && (isDocOwner(resource.data) || isAdmin());

      match /entries/{entryId} {
        allow read: if (authed() && entryId == request.auth.uid && ratingParticipant(meetupId)) || isAdmin();
        allow create, update: if authed() && validRating(meetupId, entryId);
      }
    }

    match /incidents/{incidentId} {
      allow create: if authed() && isDocOwner(request.resource.data) && request.resource.data.get('status', 'open') == 'open';
      allow read: if authed() && (isDocOwner(resource.data) || isAdmin());
      allow update: if isAdmin() || ownerReportUpdate();
      allow delete: if isAdmin();
    }

    match /bugReports/{reportId} {
      allow create: if authed() && isDocOwner(request.resource.data) && request.resource.data.get('status', 'open') == 'open';
      allow read: if authed() && (isDocOwner(resource.data) || isAdmin());
      allow update: if isAdmin() || ownerReportUpdate();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if authed() && safeSupportCreate(request.resource.data);
      allow read: if authed() && supportCanRead(resource.data);
      allow update: if resource.data.get('workflow', '') != 'growth' && (isAdmin() || ownerReportUpdate());
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if authed() && supportCanRead(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data);
        allow write: if false;
      }
    }

    match /keywordReports/{reportId} {
      allow create: if authed() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.targetUid is string &&
        request.resource.data.normalizedKeyword is string &&
        request.resource.data.normalizedKeyword.size() > 0 &&
        request.resource.data.normalizedKeyword.size() <= 50 &&
        isMutualPartyMember(request.resource.data.targetUid);
      allow read: if authed() &&
        (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /keywordModeration/{keywordId} {
      allow read: if authed();
      allow write: if false;
    }

    match /keywordEnforcement/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if authed() && isDocOwner(request.resource.data) && consistentOwnerAliases(request.resource.data);
      allow read: if authed() && (isDocOwner(resource.data) || isAdmin());
      allow update: if isAdmin() || (isDocOwner(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'ownerUid', 'userId', 'createdBy', 'reporterUid']));
      allow delete: if authed() && (isDocOwner(resource.data) || isAdmin());
    }

    // --- APP METRICS / UTIL ---
    match /metricsEvents/{eventId} {
      allow create: if authed() && isDocOwner(request.resource.data);
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow update, delete: if false;
    }

    match /dashboard/{docId} {
      allow read: if authed();
      allow write: if false;
    }

    match /dashboard/announcements/items/{announcementId} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    match /nearbyCandidates/{docId} {
      allow read: if authed();
      allow write: if false;
    }

    match /healthcheck/{docId} {
      allow read: if authed();
      allow write: if false;
    }

    match /devPush/{docId} {
      allow read, write: if isAdmin();
    }

    match /cells/{cellId} {
      allow read: if authed();
      allow write: if false;
    }

    match /_bridges/{docId} {
      allow read: if authed();
      allow write: if false;
    }

    match /paymentReconciliation/{eventId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operatorStatus', 'operatorNote', 'operatorUpdatedAt']);
      allow create, delete: if false;
    }

    // Growth grants, eligibility, diagnostics and operational timestamps are
    // exclusively written by authenticated callables and evidence triggers.
    match /growthMembers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /growthDailyMetrics/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /growthOpsAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Owner drafts and the moderation queue are private; publication is only
    // written by paid-entitlement checked callables and human administrator review.
    match /businessOffers/{offerId} {
      allow read: if isAdmin() || (authed() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // The public audience still needs live entitlement, block and mutual Party
    // checks, so customers obtain a bounded allowlisted page through the callable.
    match /publicBusinessOffers/{offerId} {
      allow read, write: if false;
    }
    match /businessOfferRequests/{id} { allow read, write: if false; }
    match /businessOfferBudgets/{id} { allow read, write: if false; }
    match /businessOfferTombstones/{id} { allow read, write: if false; }

    // Deny unknown paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
